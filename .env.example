# Server only. Read by the Vercel functions in /api and by the Vite dev middleware.
# Do not prefix this with VITE_. The client bundle must never receive it.
# Used for Gemini text/vision calls and for minting Live API ephemeral tokens.
GEMINI_API_KEY=

# Optional. If neither pair is set, POST /api/farm returns { "synced": false } and data stays on the device.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Off unless set to the exact string true. Phone audio still needs a long-lived server.
# PHONE_CALL_ENABLED=false
# WHATSAPP_SUMMARY_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_FROM=
